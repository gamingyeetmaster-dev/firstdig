# Copy to .env for local development. Everything is optional locally.
DEV_MODE=1                      # 1 = show magic links on screen when email isn't configured
BASE_URL=http://127.0.0.1:8000  # public URL in production, e.g. https://torontosignals.ca
SECRET_KEY=change-me            # long random string; signs session cookies
CRON_SECRET=change-me           # protects /tasks/refresh and /tasks/digests
ADMIN_EMAILS=you@example.com    # comma list; admins get full access and /admin
TRIAL_DAYS=14
FREE_DELAY_DAYS=21

# Email (resend.com). Without it, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Toronto Signals <hello@yourdomain.ca>

# Stripe (stripe.com). Without it, the site runs on free trials only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEARDOWN=
STRIPE_PRICE_OPENINGS=
STRIPE_PRICE_BUNDLE=

# Scheduler: 1 = refresh data + send digests daily inside the web process
ENABLE_SCHEDULER=0
REFRESH_HOUR=6
